# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CAMPUSONE_SECRET=replace-with-a-long-random-secret
# Configure once, before starting the app. Registration for this email gets the admin role.
CAMPUSONE_ADMIN_EMAIL=admin@your-campus.edu
# Persistent writable directory for SQLite and uploads (use a mounted disk in production).
CAMPUSONE_DATA_DIR=./instance
HOST=127.0.0.1
PORT=5000
COOKIE_SECURE=0
